{
  "name": "dsh-flash-skin",
  "version": "0.1.0",
  "description": "Flash Skin: a portrait-driven skin for DeepSeek Harness whose backdrop swaps character portraits as the reasoning level rises and flips the shell from light to dark at the top tiers. Three drivers — manual, follow-reasoning and a composite weighted mode that scores token usage, context pressure, reasoning effort and token speed in real time and maps the score straight onto the group's actual frame count; per-signal weights and decay tuning are configurable in the detail page.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/local/dsh-flash-skin.git"
  },
  "homepage": "https://github.com/local/dsh-flash-skin#readme",
  "bugs": "https://github.com/local/dsh-flash-skin/issues",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "./src/index.js",
    "lib/client.js",
    "lib/client.js.map",
    "locale/zh.json",
    "locale/en.json",
    "src/index.js",
    "src/range.js",
    "icon.svg",
    "README.md",
    "examples/portrait-archives",
    "examples/portrait-manifest/README.md"
  ],
  "icon": "./icon.svg",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "node ./scripts/build-client.mjs",
    "test": "vitest run"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "devDependencies": {
    "@types/react": "~18.3.1",
    "esbuild": "^0.25.0",
    "vitest": "^4.1.10"
  }
}
